<nav>
  <a href="/records/add">Add Record</a>

  <form action="/logout" method="POST" style="display:inline">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <button type="submit">Logout</button>
  </form>
</nav>

<h1>Fuel Records</h1>

{{#if records.length}}
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Vehicle</th>
        <th>Liters</th>
        <th>Distance km</th>
        <th>Total Cost</th>
        <th>km/L</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each records}}
        <tr>
          <td>{{date}}</td>
          <td>{{vehicleType}}</td>
          <td>{{liters}}</td>
          <td>{{distanceKm}}</td>
          <td>${{totalCost}}</td>
          <td>{{kmPerLiter}}</td>
          <td>
            <a href="/records/{{id}}/edit">Edit</a>

            <form action="/records/{{id}}?_method=DELETE" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="{{../csrfToken}}">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No records yet.</p>
{{/if}}

<h2>Weekly Spending</h2>

{{#if summary.weekly.length}}
  <table>
    <thead>
      <tr>
        <th>Week</th>
        <th>Total Cost</th>
      </tr>
    </thead>
    <tbody>
      {{#each summary.weekly}}
        <tr>
          <td>{{period}}</td>
          <td>${{total}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No weekly data yet.</p>
{{/if}}

<h2>Monthly Spending</h2>

{{#if summary.monthly.length}}
  <table>
    <thead>
      <tr>
        <th>Month</th>
        <th>Total Cost</th>
      </tr>
    </thead>
    <tbody>
      {{#each summary.monthly}}
        <tr>
          <td>{{period}}</td>
          <td>${{total}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No monthly data yet.</p>
{{/if}}