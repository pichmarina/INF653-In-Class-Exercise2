<section class="page-header">
  <div>
    <p class="eyebrow">Dashboard</p>
    <h1>Fuel Records</h1>
    <p class="muted">Track fuel usage, cost, and vehicle efficiency.</p>
  </div>

  <div class="header-actions">
    <a class="btn btn-primary" href="/records/add">Add Record</a>

    <form class="inline-form" action="/logout" method="POST" onsubmit="return confirm('Are you sure you want to logout?');">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <button class="btn btn-secondary" type="submit">Logout</button>
    </form>


  </div>
</section>

<section class="card">
  <div class="card-title">
    <h2>Fuel Activity</h2>
    <p class="muted">All saved fuel records for your account.</p>
  </div>

  {{#if records.length}}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Vehicle</th>
            <th>Liters</th>
            <th>Distance km</th>
            <th>Total Cost</th>
            <th>km/L</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each records}}
            <tr>
              <td>{{date}}</td>
              <td><span class="badge">{{vehicleType}}</span></td>
              <td>{{liters}}</td>
              <td>{{distanceKm}}</td>
              <td>${{totalCost}}</td>
              <td><strong>{{kmPerLiter}}</strong></td>
              <td class="actions">
                <a class="btn btn-small btn-secondary" href="/records/{{id}}/edit">Edit</a>

                <form class="inline-form" action="/records/{{id}}?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this fuel record?');">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                  <button class="btn btn-small btn-danger" type="submit">Delete</button>
                </form>


              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="empty-state">
      <h2>No records yet</h2>
      <p>Add your first fuel record to see your km/L and spending summary.</p>
      <a class="btn btn-primary" href="/records/add">Add First Record</a>
    </div>
  {{/if}}
</section>

<section class="summary-grid">
  <div class="card">
    <div class="card-title">
      <h2>Weekly Spending</h2>
      <p class="muted">Fuel cost grouped by week.</p>
    </div>

    {{#if summary.weekly.length}}
      <table>
        <thead>
          <tr>
            <th>Week</th>
            <th>Total Cost</th>
          </tr>
        </thead>
        <tbody>
          {{#each summary.weekly}}
            <tr>
              <td>{{period}}</td>
              <td><strong>${{total}}</strong></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p class="muted">No weekly data yet.</p>
    {{/if}}
  </div>

  <div class="card">
    <div class="card-title">
      <h2>Monthly Spending</h2>
      <p class="muted">Fuel cost grouped by month.</p>
    </div>

    {{#if summary.monthly.length}}
      <table>
        <thead>
          <tr>
            <th>Month</th>
            <th>Total Cost</th>
          </tr>
        </thead>
        <tbody>
          {{#each summary.monthly}}
            <tr>
              <td>{{period}}</td>
              <td><strong>${{total}}</strong></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p class="muted">No monthly data yet.</p>
    {{/if}}
  </div>
</section>
