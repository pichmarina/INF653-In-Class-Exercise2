<h1>Edit Fuel Record</h1>

<form action="/records/{{record.id}}?_method=PUT" method="POST">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">

  <label for="date">Date</label>
  <input id="date" type="date" name="date" value="{{record.date}}" required>

  <label for="vehicleType">Vehicle Type</label>
  <select id="vehicleType" name="vehicleType" required>
    <option value="Car">Car</option>
    <option value="Motorcycle">Motorcycle</option>
  </select>

  <label for="liters">Liters</label>
  <input id="liters" type="number" step="0.01" min="0.01" name="liters" value="{{record.liters}}" required>

  <label for="distanceKm">Distance Traveled km</label>
  <input id="distanceKm" type="number" step="0.01" min="0" name="distanceKm" value="{{record.distanceKm}}" required>

  <label for="totalCost">Total Cost</label>
  <input id="totalCost" type="number" step="0.01" min="0" name="totalCost" value="{{record.totalCost}}" required>

  <button type="submit">Update Record</button>
</form>

<p>
  <a href="/records">Back to dashboard</a>
</p>